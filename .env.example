# ---------- Meta / WhatsApp Cloud API ----------
# Token de acesso do app "Combinado" (Meta for Developers > WhatsApp > Configuração da API)
# Comece com o token temporário para testar; troque por um token permanente de usuário do sistema
# quando for para produção (dura mais e não expira em 24h).
WHATSAPP_TOKEN=

# Texto que você escolhe para o campo "Verify Token" na configuração do Webhook, na Meta.
WHATSAPP_VERIFY_TOKEN=combinado-verify-2026

# Versão da Graph API usada nas chamadas (ajuste se a Meta pedir outra versão)
GRAPH_API_VERSION=v21.0

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Modelo econômico, bom o bastante para esta tarefa
OPENAI_MODEL=gpt-4o-mini

# ---------- Google Calendar ----------
# Caminho do arquivo JSON da conta de serviço baixado no Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/combinado-servidor.json

# ---------- Cliente: Barbearia do Elias ----------
# Phone Number ID do número do Elias no WhatsApp (Meta > WhatsApp > Configuração da API)
ELIAS_PHONE_NUMBER_ID=
# ID da agenda do Google Calendar "Barbearia do Elias" (termina em @group.calendar.google.com)
ELIAS_CALENDAR_ID=
# Número do Elias em formato internacional, sem símbolos (ex: 5521999999999) - usado no modo dono
ELIAS_OWNER_PHONE=
# Código de 4 dígitos que o Elias usa para entrar no modo dono
ELIAS_OWNER_CODE=1234
# Nome do template aprovado na Meta para o lembrete da véspera (crie em WhatsApp > Modelos de mensagem)
ELIAS_REMINDER_TEMPLATE=lembrete_vespera
# Nome da barbearia usado pelo assistente nas conversas (opcional; troque aqui se o nome mudar).
ELIAS_DISPLAY_NAME=Barbearia do Elias

# ---------- Alerta de falhas ----------
# Seu telefone (quem cuida do Combinado), em formato internacional, sem símbolos. Quando algo falha
# (WhatsApp, Google, IA ou erro inesperado), o bot manda um aviso curto para este número.
# Vazio = não avisa (só aparece nos logs do Render).
ALERT_PHONE=
# Opcional: nome de um template aprovado na Meta, com 1 variável no corpo, usado quando o texto
# livre não chega (o WhatsApp só entrega texto livre se você escreveu para o bot nas últimas 24h).
ALERT_TEMPLATE=
# Coloque 1 para receber um aviso também a cada vez que o servidor iniciar.
ALERT_ON_BOOT=
# Senha para testar o alerta abrindo https://SEU-APP.onrender.com/teste-alerta?chave=SENHA no navegador.
# Vazia = o teste fica desligado. Use uma senha longa e remova depois de testar, se quiser.
ALERT_TEST_KEY=

# ---------- Servidor ----------
PORT=3000
